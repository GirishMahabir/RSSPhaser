# Copy this file to ".env" and edit the values, then run `docker compose up`.

# --- Admin web UI credentials (single admin account) ---
# Username for the admin login.
ADMIN_USER=admin
# Bcrypt hash of the admin password. Generate it with:
#   docker compose run --rm app python gen_password_hash.py
# (or:  python gen_password_hash.py 'your-password'  )
# The example below is a valid bcrypt hash of the password "changeme" — REPLACE IT.
# IMPORTANT: wrap the hash in SINGLE QUOTES. bcrypt hashes contain '$' characters
# and Docker Compose would otherwise try to interpolate them (e.g. "$12" / "$rk...")
# and silently corrupt the value. Single quotes make Compose treat it literally.
ADMIN_PASSWORD_HASH='$2b$12$rkABXnSeBtTfxrIJtk85W.65BnMMnzQArlhAdiP23dljFqQihrh3.'

# Flask session signing secret. Use a long random value in production, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=please-change-me-to-a-long-random-string

# --- Database connection ---
# These defaults line up with the MariaDB service in docker-compose.yml.
DB_HOST=db
DB_PORT=3306
DB_NAME=rssphaser
DB_USER=rssphaser
DB_PASSWORD=rssphaser_password
# Root password used to initialize the MariaDB container.
DB_ROOT_PASSWORD=root_password

# --- Optional overrides of config.yaml operational tunables ---
# Uncomment to override; otherwise values from config.yaml are used.
# POLL_INTERVAL_MINUTES=15
# BODY_TRUNCATE_BYTES=102400
# OUTPUT_ITEM_CAP=200
# RETENTION_MAX_MATCHES=5000
# RETENTION_MAX_AGE_DAYS=90
# HTTP_CONNECT_TIMEOUT_SECONDS=10
# HTTP_READ_TIMEOUT_SECONDS=20
# HTTP_MAX_RETRIES=3
# POLL_MAX_WORKERS=5

# Path to the config file inside the container (rarely changed).
CONFIG_PATH=/app/config.yaml

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
